# Copy to .env and fill in whichever providers you use. litellm reads these
# automatically. You only need the key(s) for the model strings you pass to
# --models. No key is needed to run the classic-only tournament or the tests.

# OpenAI  (model strings like: gpt-4o-mini)
OPENAI_API_KEY=

# Anthropic  (model strings like: claude-haiku-4-5)
ANTHROPIC_API_KEY=

# Ollama (local, free) needs no key. Run `ollama serve` and use model strings
# like: ollama/llama3
